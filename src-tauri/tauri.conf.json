{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bicord",
  "version": "0.1.0",
  "identifier": "com.github.import-ai.bicord",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Bicord",
      "titleBarStyle": "Transparent",
      "backgroundColor": "#ffffff",
      "theme": "Light",
      "width": 420,
      "height": 740,
      "minWidth": 420,
      "maxWidth": 420,
      "minHeight": 580,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
